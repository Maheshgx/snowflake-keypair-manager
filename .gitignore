# macOS
.DS_Store

# Python
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
pip-wheel-metadata/
wheelhouse/

# Virtual environments
env/
venv/
ENV/
.env
.venv/
env.bak/
venv.bak/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*.cover

# Translations
*.mo
*.pot

# IDEs and editors
.vscode/
.idea/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# mypy
.mypy_cache/
.dmypy.json

# Pyre
.pyre/

# Profiling
profile_default/

# IPython
ipython_config.py

# Byte-compiled / C extension artifacts
*.pyd
*.pyo
*.pdb

# Toml and related configuration files
# NOTE: user requested TOML-related files to be ignored. This will ignore all .toml files.
*.toml

# Optional: lock files often alongside toml configs (if you want to ignore them as well)
*.lock

# Misc
.coverage
coverage.html

